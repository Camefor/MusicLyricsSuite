<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lyrics-suite</AssemblyName>
    <RootNamespace>LyricsSuite</RootNamespace>
    <Version>1.0.0</Version>
    <Description>编排 LyricsFetcher 与 LrcTagger 的交互式控制台：选专辑目录 → 读标签 → 拉歌词 → 嵌入音频。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LyricsFetcher\LyricsFetcher.csproj" />
    <ProjectReference Include="..\LrcTagger\LrcTagger.csproj" />
  </ItemGroup>

</Project>
